# ═══════════════════════════════════════════════════════════════
# EdenVanguard Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to the repository.
#
# Every variable below is actually read by the code (grep
# 'process.env.' across shared/ pterodactyl-mcp/ vanguard/ aegis/
# to verify). LLM keys and Pterodactyl tokens are NOT read from the
# environment at runtime — they live encrypted in PostgreSQL (see
# "Database-seeded credentials" at the bottom).

# ── Discord (vanguard) ───────────────────────────────────────
# Bot token from the Discord Developer Portal
DISCORD_BOT_TOKEN=
# Application ID of the bot (used to register slash commands)
DISCORD_CLIENT_ID=
# Discord user IDs of bot administrators (comma-separated)
ADMIN_DISCORD_IDS=

# ── Pterodactyl (pterodactyl-mcp) ────────────────────────────
# Panel base URL (no trailing slash)
PTERO_PANEL_URL=
# Default server identifier used by single-server deployments /
# cron jobs when no explicit target is provided
PTERODACTYL_SERVER_ID=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://edenvanguard:changeme@localhost:5432/edenvanguard

# ── NATS (IPC between vanguard and aegis) ────────────────────
NATS_URL=nats://localhost:4222

# ── Encryption ───────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of ptero_credentials
# and api_keys rows. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Database-seeded credentials (NOT read from this file) ────
# LLM provider keys (provider='groq') are stored in the api_keys
# table; Pterodactyl ptla_/ptlc_ tokens are stored (AES-256-GCM
# encrypted) in the ptero_credentials table. Seed them with SQL or
# the admin flows, then rotate without restart. The placeholder
# names below document the intended bootstrap values:
#   GROQ_API_KEY_1=gsk_...   -> INSERT INTO api_keys (provider, ...)
#   PTERO_APP_KEY=ptla_...   -> INSERT INTO ptero_credentials (credential_type='application', ...)
#   PTERO_CLIENT_KEY=ptlc_...-> INSERT INTO ptero_credentials (credential_type='client', ...)
